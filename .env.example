# ========================================================
# DATABASE CONFIGURATION
# ========================================================
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production on Vercel (Postgres - e.g. Neon.tech, Supabase, Vercel Postgres):
# In prisma/schema.prisma change: provider = "postgresql"
# DATABASE_URL="postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ========================================================
# ADMIN SECURITY / AUTH
# ========================================================
# Secret key required to access GET /api/contact in production
# Pass as Header: "Authorization: Bearer your-secure-admin-secret" or "x-admin-key: your-secure-admin-secret"
ADMIN_API_KEY="evaroid-secure-admin-key-replace-this"

# ========================================================
# EMAIL NOTIFICATIONS (Gmail SMTP or Resend)
# ========================================================
CONTACT_RECEIVER_EMAIL="arbazkhanofficial140@gmail.com"

# Gmail SMTP Configuration:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="arbazkhanofficial140@gmail.com"
SMTP_PASS="your-16-char-google-app-password"
SMTP_FROM="\"Evaroid.AI Leads\" <arbazkhanofficial140@gmail.com>"

# ========================================================
# AUTOMATED WHATSAPP NOTIFICATIONS (CallMeBot free API)
# ========================================================
